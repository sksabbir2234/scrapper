DATABASE_URL=postgresql://newsuser:newspass@localhost:5432/newsdb
DEBUG=false
SCRAPER_USER_AGENT=NewsAggregatorBot/1.0 (+https://yoursite.com/bot)
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5

# Scheduler: interval in minutes (default 30) or cron expression (overrides interval)
SCRAPE_INTERVAL_MINUTES=30
# SCRAPE_CRON_EXPRESSION=0 */6 *  # every 6 hours (5-field cron: min hour day month weekday)

# Admin
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=change-this-to-a-long-random-string
ADMIN_TOKEN_EXPIRE_HOURS=24

# App
SITE_URL=http://localhost:8000

# Optional: API keys
GROQ_API_KEY=
GITHUB_TOKEN=

# Pexels API (free, get key at https://www.pexels.com/api/)
PEXELS_API_KEY=
